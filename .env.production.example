# SahlBiz production environment template
# Copy to .env for deployment and replace every CHANGE_ME value with a secret-manager value.
# Never commit real credentials or private keys.

# PostgreSQL
POSTGRES_DB=sahlbiz
POSTGRES_USER=sahlbiz
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password
DATABASE_URL=postgresql://sahlbiz:CHANGE_ME_use_a_long_random_database_password@postgres:5432/sahlbiz?schema=public
DIRECT_URL=postgresql://sahlbiz:CHANGE_ME_use_a_long_random_database_password@postgres:5432/sahlbiz?schema=public

# Redis
REDIS_PASSWORD=CHANGE_ME_use_a_long_random_redis_password
REDIS_URL=redis://:CHANGE_ME_use_a_long_random_redis_password@redis:6379

# Object storage / MinIO values required by docker-compose.production.yml
MINIO_ROOT_USER=CHANGE_ME_minio_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME_use_a_long_random_minio_password
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=CHANGE_ME_storage_access_key
STORAGE_SECRET_KEY=CHANGE_ME_use_a_long_random_storage_secret
STORAGE_BUCKET=sahlbiz
STORAGE_REGION=us-east-1

# Names consumed by packages/storage at runtime
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sahlbiz
S3_ACCESS_KEY_ID=CHANGE_ME_storage_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_use_a_long_random_storage_secret
S3_FORCE_PATH_STYLE=true

# Application security and networking
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_use_at_least_32_random_characters
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=false

# API and web ports
PORT=4000
WEB_PORT=3000

# Migration/startup behavior
RUN_MIGRATIONS=true
START_AFTER_MIGRATIONS=true

# Optional rate-limit overrides
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=10

# Optional web API base URL; leave unset to use the same-origin /api/v1 route.
# NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
