{
  "name": "sahlbiz",
  "private": true,
  "version": "0.2.0-rc.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sahlbiz/web",
    "prisma:migrate:reset": "npm run prisma:migrate:reset -w @sahlbiz/database",
    "build": "npm run build -w @sahlbiz/web",
    "lint": "npm run lint -w @sahlbiz/web",
    "db:generate": "npm run prisma:generate -w @sahlbiz/database",
    "db:migrate": "npm run prisma:migrate -w @sahlbiz/database",
    "db:seed": "npm run prisma:seed -w @sahlbiz/database",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w @sahlbiz/database",
    "db:migrate:fresh": "npm run prisma:migrate:fresh -w @sahlbiz/database",
    "test": "npm run test -w @sahlbiz/api",
    "typecheck": "npm run typecheck -w @sahlbiz/web",
    "validate": "node scripts/validate-repo.mjs",
    "ci": "npm run validate && npm run typecheck && npm run build",
    "e2e": "npm run e2e -w @sahlbiz/api",
    "ops:backup": "./scripts/backup-postgres.sh",
    "ops:restore": "./scripts/restore-postgres.sh",
    "release:check": "node scripts/release-check.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "ops:backup-objects": "sh scripts/backup-object-storage.sh",
    "ops:restore-objects": "sh scripts/restore-object-storage.sh"
  },
  "dependencies": {
    "@prisma/composer": "0.20.0",
    "@prisma/composer-prisma-cloud": "0.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "pg": "^8.23.0",
    "postcss": "^8.5.26"
  },
  "allowScripts": {
    "prisma": true,
    "msgpackr-extract": true,
    "esbuild": true,
    "@prisma/engines": true,
    "@prisma/client": true
  },
  "devDependencies": {
    "prisma": "8.0.0-rc.15"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  }
}
