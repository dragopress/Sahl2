{
  "name": "@sahlbiz/api",
  "private": true,
  "version": "0.2.0-rc.1",
  "scripts": {
    "prestart": "tsc -p ../../packages/storage/tsconfig.json",
    "start": "nest start",
    "prestart:dev": "tsc -p ../../packages/storage/tsconfig.json",
    "start:dev": "nest start --watch",
    "prebuild": "tsc -p ../../packages/storage/tsconfig.json",
    "pretypecheck": "tsc -p ../../packages/storage/tsconfig.json",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.spec.ts",
    "e2e": "tsx --test ../../tests/e2e/critical-workflows.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@prisma/client": "6.19.3",
    "@sahlbiz/storage": "*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.4"
  }
}
