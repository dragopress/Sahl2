generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum MembershipRole { OWNER ADMIN MANAGER ACCOUNTANT SALES EMPLOYEE VIEWER }
enum CustomerType { INDIVIDUAL COMPANY }
enum InvoiceStatus { DRAFT SENT PARTIALLY_PAID PAID OVERDUE CANCELLED }
enum QuoteStatus { DRAFT SENT ACCEPTED REJECTED EXPIRED CONVERTED }
enum NumberSequenceType { QUOTE INVOICE }
enum NotificationType { OVERDUE_INVOICE LOW_STOCK TASK_DUE EXPENSE_APPROVAL CASHFLOW_RISK SYSTEM }
enum AutomationRuleType { OVERDUE_INVOICES LOW_STOCK TASK_DEADLINES EXPENSE_APPROVAL CASHFLOW_RISK }
enum DocumentCategory { CONTRACT INVOICE QUOTE RECEIPT COMPANY CUSTOMER PROJECT OTHER }
enum DocumentVisibility { ORGANIZATION RESTRICTED }
enum AccountType { ASSET LIABILITY EQUITY REVENUE EXPENSE }
enum JournalSourceType { SALES_INVOICE SALES_PAYMENT EXPENSE MANUAL SUPPLIER_BILL SUPPLIER_PAYMENT VAT_SETTLEMENT }
enum CashAccountType { BANK CASH MOBILE_WALLET }
enum CashTransactionType { INCOME EXPENSE TRANSFER_IN TRANSFER_OUT }
enum ExpenseStatus { SUBMITTED APPROVED REJECTED PAID }
enum ExpensePaymentMethod { CASH BANK CARD MOBILE_WALLET OTHER }
enum ProductType { PRODUCT SERVICE }
enum StockMovementType { OPENING RECEIPT SALE_ISSUE ADJUSTMENT_IN ADJUSTMENT_OUT TRANSFER_IN TRANSFER_OUT }
model Organization { id String @id @default(cuid()) name String slug String @unique ice String? memberships Membership[] customers Customer[] quotes Quote[] invoices Invoice[] payments Payment[] expenses Expense[] projects Project[] tasks Task[] auditLogs AuditLog[] sequences NumberSequence[] accounts Account[] journalEntries JournalEntry[] cashAccounts CashAccount[] productCategories ProductCategory[] products Product[] warehouses Warehouse[] stockMovements StockMovement[] suppliers Supplier[] supplierBills SupplierBill[] supplierPayments SupplierPayment[] bankStatementLines BankStatementLine[] notifications Notification[] automationRules AutomationRule[] documents Document[] aiInsights AiInsight[] documentTags DocumentTag[] documentPermissions DocumentPermission[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model User { id String @id @default(cuid()) email String @unique name String passwordHash String? emailVerifiedAt DateTime? memberships Membership[] sessions Session[] verificationTokens VerificationToken[] passwordResetTokens PasswordResetToken[] auditLogs AuditLog[] notifications Notification[] aiInsights AiInsight[] documentsCreated Document[] @relation("DocumentCreatedBy") documentVersionsCreated DocumentVersion[] @relation("DocumentVersionCreatedBy") documentPermissions DocumentPermission[] @relation("DocumentUserPermission") expenseEmployees Expense[] @relation("ExpenseEmployee") expenseApprovals Expense[] @relation("ExpenseApprover") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Notification { id String @id @default(cuid()) organizationId String userId String? type NotificationType title String message String readAt DateTime? entityType String? entityId String? createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) user User? @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([organizationId,createdAt]) @@index([userId,readAt]) }
model AutomationRule { id String @id @default(cuid()) organizationId String name String type AutomationRuleType enabled Boolean @default(true) config Json @default("{}") lastRunAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) @@unique([organizationId,name]) @@index([organizationId,enabled,type]) }
model Membership { id String @id @default(cuid()) organizationId String userId String role MembershipRole organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([organizationId,userId]) @@index([organizationId]) }
model Session { id String @id @default(cuid()) tokenHash String @unique userId String expiresAt DateTime lastSeenAt DateTime @default(now()) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model VerificationToken { id String @id @default(cuid()) tokenHash String @unique userId String expiresAt DateTime user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model PasswordResetToken { id String @id @default(cuid()) tokenHash String @unique userId String expiresAt DateTime user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model Customer { id String @id @default(cuid()) organizationId String type CustomerType @default(COMPANY) name String email String? phone String? ice String? quotes Quote[] invoices Invoice[] projects Project[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) @@index([organizationId,name]) }
model ProductCategory { id String @id @default(cuid()) organizationId String name String active Boolean @default(true) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) products Product[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,name]) @@index([organizationId,active]) }
model Product { id String @id @default(cuid()) organizationId String categoryId String? type ProductType @default(PRODUCT) sku String? barcode String? name String description String? purchasePrice Decimal @default(0) @db.Decimal(14,2) sellingPrice Decimal @default(0) @db.Decimal(14,2) taxRate Decimal @default(20) @db.Decimal(5,2) unit String @default("unité") stock Decimal @default(0) @db.Decimal(14,3) minimumStock Decimal @default(0) @db.Decimal(14,3) supplier String? active Boolean @default(true) category ProductCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) quoteItems QuoteItem[] invoiceItems InvoiceItem[] warehouseStocks WarehouseStock[] stockMovements StockMovement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,sku]) @@index([organizationId,name]) @@index([organizationId,type,active]) }
model Quote { id String @id @default(cuid()) organizationId String customerId String projectId String? number String status QuoteStatus @default(DRAFT) subtotal Decimal @db.Decimal(14,2) discount Decimal @default(0) @db.Decimal(14,2) tax Decimal @db.Decimal(14,2) total Decimal @db.Decimal(14,2) issuedAt DateTime? validUntil DateTime? notes String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id]) project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull) items QuoteItem[] invoices Invoice[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,number]) @@index([organizationId,status]) @@index([organizationId,projectId]) }
model QuoteItem { id String @id @default(cuid()) quoteId String productId String? description String quantity Decimal @db.Decimal(14,3) unitPrice Decimal @db.Decimal(14,2) taxRate Decimal @default(20) @db.Decimal(5,2) lineSubtotal Decimal @db.Decimal(14,2) lineTax Decimal @db.Decimal(14,2) lineTotal Decimal @db.Decimal(14,2) quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade) product Product? @relation(fields:[productId],references:[id],onDelete:SetNull) @@index([quoteId]) @@index([productId]) }
model Invoice { id String @id @default(cuid()) organizationId String customerId String projectId String? quoteId String? warehouseId String? number String status InvoiceStatus @default(DRAFT) subtotal Decimal @db.Decimal(14,2) discount Decimal @default(0) @db.Decimal(14,2) tax Decimal @db.Decimal(14,2) total Decimal @db.Decimal(14,2) dueAt DateTime? issuedAt DateTime? notes String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id]) project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull) warehouse Warehouse? @relation(fields:[warehouseId],references:[id],onDelete:SetNull) quote Quote? @relation(fields:[quoteId],references:[id]) items InvoiceItem[] payments Payment[] stockPostedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,number]) @@index([organizationId,status,dueAt]) @@index([organizationId,projectId]) }
model InvoiceItem { id String @id @default(cuid()) invoiceId String productId String? description String quantity Decimal @db.Decimal(14,3) unitPrice Decimal @db.Decimal(14,2) taxRate Decimal @default(20) @db.Decimal(5,2) lineSubtotal Decimal @db.Decimal(14,2) lineTax Decimal @db.Decimal(14,2) lineTotal Decimal @db.Decimal(14,2) invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade) product Product? @relation(fields:[productId],references:[id],onDelete:SetNull) @@index([invoiceId]) @@index([productId]) }

model Warehouse { id String @id @default(cuid()) organizationId String name String code String active Boolean @default(true) isDefault Boolean @default(false) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) stocks WarehouseStock[] movements StockMovement[] invoices Invoice[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,code]) @@index([organizationId,active]) }
model WarehouseStock { id String @id @default(cuid()) warehouseId String productId String quantity Decimal @default(0) @db.Decimal(14,3) warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) @@unique([warehouseId,productId]) @@index([productId]) }
model StockMovement { id String @id @default(cuid()) organizationId String warehouseId String productId String quantity Decimal @db.Decimal(14,3) type StockMovementType sourceType String? sourceId String? note String? occurredAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@index([organizationId,occurredAt]) @@index([warehouseId,productId,occurredAt]) @@index([organizationId,sourceType,sourceId]) }
model Payment { id String @id @default(cuid()) organizationId String invoiceId String amount Decimal @db.Decimal(14,2) paidAt DateTime method String? reference String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) invoice Invoice @relation(fields:[invoiceId],references:[id]) createdAt DateTime @default(now()) @@index([organizationId,paidAt]) }
model NumberSequence { id String @id @default(cuid()) organizationId String type NumberSequenceType year Int nextValue Int @default(1) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) @@unique([organizationId,type,year]) }
model Expense { id String @id @default(cuid()) organizationId String category String amount Decimal @db.Decimal(14,2) taxRate Decimal @default(0) @db.Decimal(5,2) taxAmount Decimal @default(0) @db.Decimal(14,2) netAmount Decimal @default(0) @db.Decimal(14,2) incurredAt DateTime description String? accountCode String? cashAccountId String? supplierId String? employeeId String? projectId String? attachmentUrl String? paymentMethod ExpensePaymentMethod? status ExpenseStatus @default(SUBMITTED) approvedAt DateTime? approvedById String? paidAt DateTime? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) cashAccount CashAccount? @relation(fields:[cashAccountId],references:[id],onDelete:SetNull) supplier Supplier? @relation(fields:[supplierId],references:[id],onDelete:SetNull) employee User? @relation("ExpenseEmployee",fields:[employeeId],references:[id],onDelete:SetNull) approvedBy User? @relation("ExpenseApprover",fields:[approvedById],references:[id],onDelete:SetNull) project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([organizationId,incurredAt]) @@index([organizationId,status,incurredAt]) @@index([organizationId,projectId]) }
model Account { id String @id @default(cuid()) organizationId String code String name String type AccountType active Boolean @default(true) parentId String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) parent Account? @relation("AccountTree",fields:[parentId],references:[id],onDelete:SetNull) children Account[] journalLines JournalLine[] cashAccounts CashAccount[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,code]) @@index([organizationId,type,active]) }
model JournalEntry { id String @id @default(cuid()) organizationId String number String entryDate DateTime description String sourceType JournalSourceType sourceId String? postedAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) lines JournalLine[] @@unique([organizationId,number]) @@unique([organizationId,sourceType,sourceId]) @@index([organizationId,entryDate]) }
model JournalLine { id String @id @default(cuid()) journalEntryId String accountId String debit Decimal @default(0) @db.Decimal(14,2) credit Decimal @default(0) @db.Decimal(14,2) description String? journalEntry JournalEntry @relation(fields:[journalEntryId],references:[id],onDelete:Cascade) account Account @relation(fields:[accountId],references:[id]) @@index([journalEntryId]) @@index([accountId]) }
model CashAccount { id String @id @default(cuid()) organizationId String accountId String name String type CashAccountType currency String @default("MAD") openingBalance Decimal @default(0) @db.Decimal(14,2) active Boolean @default(true) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) account Account @relation(fields:[accountId],references:[id]) transactions CashTransaction[] expenses Expense[] supplierPayments SupplierPayment[] bankStatementLines BankStatementLine[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,name]) @@index([organizationId,active]) }
model CashTransaction { id String @id @default(cuid()) organizationId String cashAccountId String type CashTransactionType amount Decimal @db.Decimal(14,2) transactionDate DateTime description String? reference String? sourceType String? sourceId String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) cashAccount CashAccount @relation(fields:[cashAccountId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@index([organizationId,transactionDate]) @@index([cashAccountId,transactionDate]) @@unique([organizationId,sourceType,sourceId]) }
model Project { id String @id @default(cuid()) organizationId String customerId String? name String budget Decimal? @db.Decimal(14,2) status String @default("ACTIVE") organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) customer Customer? @relation(fields:[customerId],references:[id]) tasks Task[] expenses Expense[] invoices Invoice[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([organizationId,status]) }
model Task { id String @id @default(cuid()) organizationId String projectId String? title String status String @default("TODO") dueAt DateTime? assigneeId String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) project Project? @relation(fields:[projectId],references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([organizationId,status,dueAt]) }

model Document {
 id String @id @default(cuid())
 organizationId String
 name String
 category DocumentCategory
 visibility DocumentVisibility @default(ORGANIZATION)
 mimeType String
 sizeBytes BigInt
 storageKey String
 checksum String?
 entityType String?
 entityId String?
 expiresAt DateTime?
 currentVersion Int @default(1)
 createdById String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 createdBy User @relation("DocumentCreatedBy",fields:[createdById],references:[id])
 versions DocumentVersion[]
 tags DocumentTag[]
 permissions DocumentPermission[]
 @@index([organizationId,category,createdAt])
 @@index([organizationId,entityType,entityId])
 @@index([organizationId,expiresAt])
 @@index([organizationId,name])
}
model DocumentVersion {
 id String @id @default(cuid())
 documentId String
 version Int
 storageKey String
 mimeType String
 sizeBytes BigInt
 checksum String?
 createdById String
 createdAt DateTime @default(now())
 document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
 createdBy User @relation("DocumentVersionCreatedBy",fields:[createdById],references:[id])
 @@unique([documentId,version])
 @@index([documentId,createdAt])
}
model DocumentTag {
 id String @id @default(cuid())
 organizationId String
 name String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 documents Document[]
 @@unique([organizationId,name])
}
model DocumentPermission {
 id String @id @default(cuid())
 organizationId String
 documentId String
 userId String
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
 user User @relation("DocumentUserPermission",fields:[userId],references:[id],onDelete:Cascade)
 @@unique([documentId,userId])
 @@index([organizationId,userId])
}

model AuditLog { id String @id @default(cuid()) organizationId String userId String? action String entity String entityId String? previous Json? next Json? ip String? userAgent String? createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) user User? @relation(fields:[userId],references:[id]) @@index([organizationId,createdAt]) }

model Supplier { id String @id @default(cuid()) organizationId String name String ice String? ifNumber String? rc String? phone String? email String? address String? paymentTermsDays Int @default(30) active Boolean @default(true) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) bills SupplierBill[] payments SupplierPayment[] expenses Expense[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,name]) @@index([organizationId,name]) }
model SupplierBill { id String @id @default(cuid()) organizationId String supplierId String number String externalNumber String? status String @default("OPEN") subtotal Decimal @db.Decimal(14,2) tax Decimal @default(0) @db.Decimal(14,2) total Decimal @db.Decimal(14,2) dueAt DateTime? issuedAt DateTime? notes String? supplier Supplier @relation(fields:[supplierId],references:[id]) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) payments SupplierPayment[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,number]) @@index([organizationId,status,dueAt]) @@index([supplierId,issuedAt]) }
model SupplierPayment { id String @id @default(cuid()) organizationId String supplierBillId String supplierId String cashAccountId String amount Decimal @db.Decimal(14,2) paidAt DateTime method String? reference String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) supplier Supplier @relation(fields:[supplierId],references:[id]) supplierBill SupplierBill @relation(fields:[supplierBillId],references:[id]) cashAccount CashAccount @relation(fields:[cashAccountId],references:[id]) createdAt DateTime @default(now()) @@index([organizationId,paidAt]) @@index([supplierBillId]) }
model BankStatementLine { id String @id @default(cuid()) organizationId String cashAccountId String externalId String? transactionDate DateTime description String? reference String? amount Decimal @db.Decimal(14,2) direction String @default("CREDIT") status String @default("UNMATCHED") matchedCashTransactionId String? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) cashAccount CashAccount @relation(fields:[cashAccountId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId,cashAccountId,externalId]) @@index([organizationId,cashAccountId,transactionDate]) @@index([organizationId,status]) }

model AiInsight {
 id String @id @default(cuid())
 organizationId String
 userId String?
 type String
 priority String
 title String
 message String
 entityType String?
 entityId String?
 source String @default("rules")
 createdAt DateTime @default(now())
 dismissedAt DateTime?
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 user User? @relation("AiInsightUser",fields:[userId],references:[id],onDelete:SetNull)
 @@index([organizationId,createdAt])
 @@index([organizationId,dismissedAt])
 @@index([organizationId,type,createdAt])
}
